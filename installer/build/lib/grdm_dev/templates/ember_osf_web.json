{
  "service": "ember_osf_web",
  "component": "ember-osf-web",
  "command": [
    "/bin/sh",
    "-c",
    "yarn --frozen-lockfile && yarn start --host 0.0.0.0 --port 4200 --live-reload-port 41953"
  ],
  "container_port": 4200,
  "host_port": 4200,
  "expose": [
    41953
  ],
  "environment": {
    "BACKEND": "local",
    "YARN_CACHE_FOLDER": "/tmp/yarn-cache",
    "HOME": "/tmp"
  },
  "volumes": [
    {
      "volume": "ember_osf_web_dist",
      "target": "/code/dist"
    }
  ],
  "tmpfs": [
    "/tmp"
  ],
  "user": "1000:1000",
  "depends_on": [
    "api",
    "web"
  ],
  "weight": 3,
  "mem_min_mb": 1024,
  "pids_limit": 1024,
  "note": "Live-reload port 41953 is reachable inside the network only; publishing it is not in the SPEC-02 §4 table."
}
