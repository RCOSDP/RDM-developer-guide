{
  "service": "fakecas",
  "component": "fakecas",
  "profile": "minimum",
  "container_port": 8080,
  "host_port": 8080,
  "command": [
    "fakecas",
    "-host=0.0.0.0:8080",
    "-osfhost=127.0.0.1:{{HOST_PORT:web}}",
    "-dbaddress=postgres://postgres:${POSTGRES_PASSWORD}@postgres:5432/osf?sslmode=disable"
  ],
  "user": "65534:65534",
  "depends_on": [
    "postgres"
  ],
  "weight": 0.5,
  "mem_min_mb": 64,
  "pids_limit": 128
}
