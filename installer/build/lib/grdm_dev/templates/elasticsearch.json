{
  "service": "elasticsearch",
  "component": "elasticsearch2",
  "expose": [
    9200
  ],
  "environment": {
    "ES_HEAP_SIZE": "512m"
  },
  "volumes": [
    {
      "volume": "elasticsearch_data",
      "target": "/usr/share/elasticsearch/data"
    }
  ],
  "tmpfs": [
    "/tmp"
  ],
  "weight": 3,
  "mem_min_mb": 1024,
  "pids_limit": 1024
}
