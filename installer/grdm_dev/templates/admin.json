{
  "service": "admin",
  "component": "osf.io",
  "profile": "core",
  "command": [
    "invoke",
    "adminserver",
    "-h",
    "0.0.0.0"
  ],
  "environment": {
    "DJANGO_SETTINGS_MODULE": "admin.base.settings",
    "LANG": "en_US.UTF-8",
    "PYTHONUNBUFFERED": "1",
    "SECRET_KEY": "${DJANGO_SECRET_KEY}",
    "API_SECRET_KEY": "${API_SECRET_KEY}",
    "SESSION_COOKIE_SECRET": "${SESSION_COOKIE_SECRET}",
    "OSF_DB_PASSWORD": "${POSTGRES_PASSWORD}",
    "BROKER_URL": "amqp://grdm:${RABBITMQ_DEFAULT_PASS}@rabbitmq:5672/",
    "WATERBUTLER_JWE_SECRET": "${WATERBUTLER_JWE_SECRET}",
    "WATERBUTLER_JWE_SALT": "${WATERBUTLER_JWE_SALT}",
    "WATERBUTLER_JWT_SECRET": "${WATERBUTLER_JWT_SECRET}",
    "MFR_SERVER_SECRET": "${MFR_SERVER_SECRET}",
    "SHAREJS_SECRET": "${SHAREJS_SECRET}",
    "Y_WEBSOCKET_JWT_SECRET": "${Y_WEBSOCKET_JWT_SECRET}"
  },
  "env_files": [
    "osf.env"
  ],
  "volumes": [
    {
      "config": "osf/local.py",
      "target": "/code/website/settings/local.py",
      "ro": true
    },
    {
      "config": "osf/api_local.py",
      "target": "/code/api/base/settings/local.py",
      "ro": true
    },
    {
      "volume": "wiki_static",
      "target": "/code/website/static/public/js/wiki",
      "ro": true
    }
  ],
  "tmpfs": [
    "/tmp"
  ],
  "user": "1000:1000",
  "depends_on": [
    "postgres",
    "rabbitmq",
    "elasticsearch",
    {
      "service": "wiki_assets",
      "condition": "service_completed_successfully"
    }
  ],
  "weight": 2,
  "mem_min_mb": 512,
  "pids_limit": 1024,
  "container_port": 8001,
  "host_port": 8001,
  "note": "Upstream also starts crond for rdm_statistics; cron needs root, so it is left to a later milestone (non-root rule, SPEC-03 §3.3)."
}
