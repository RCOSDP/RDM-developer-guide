{
  "service": "shibboleth_sp",
  "component": "Shibboleth-SP",
  "container_port": 443,
  "expose": [
    443,
    80
  ],
  "environment": {
    "OSF_INTERNAL_URL": "http://web:5000/"
  },
  "tmpfs": [
    "/tmp",
    "/run",
    "/var/run"
  ],
  "depends_on": [
    "web",
    "test_idp"
  ],
  "weight": 1,
  "mem_min_mb": 256,
  "pids_limit": 512,
  "note": "Apache + shibd on a CentOS base run as root; exceptions in manifest/hardening.json. Replaces fakecas with --auth shibboleth."
}
