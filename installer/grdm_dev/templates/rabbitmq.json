{
  "service": "rabbitmq",
  "component": "rabbitmq",
  "expose": [
    5672,
    15672
  ],
  "environment": {
    "RABBITMQ_DEFAULT_USER": "grdm",
    "RABBITMQ_DEFAULT_PASS": "${RABBITMQ_DEFAULT_PASS}"
  },
  "volumes": [
    {
      "volume": "rabbitmq_data",
      "target": "/var/lib/rabbitmq"
    }
  ],
  "tmpfs": [
    "/tmp"
  ],
  "weight": 1,
  "mem_min_mb": 256,
  "pids_limit": 1024
}
