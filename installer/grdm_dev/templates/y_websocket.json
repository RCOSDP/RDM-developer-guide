{
  "service": "y_websocket",
  "component": "y-websocket",
  "container_port": 1234,
  "environment": {
    "HOST": "0.0.0.0",
    "PORT": "1234",
    "JWT_SECRET": "${Y_WEBSOCKET_JWT_SECRET}",
    "HOME": "/tmp"
  },
  "tmpfs": [
    "/tmp"
  ],
  "user": "1000:1000",
  "depends_on": [
    "web"
  ],
  "weight": 1,
  "mem_min_mb": 128,
  "pids_limit": 256,
  "host_port": 1234
}
