<?xml version="1.0" encoding="UTF-8"?>
<!-- generated by grdm-dev compose render from templates/idp/sp-shibboleth2.xml.tmpl; do not edit (ADR-05, SPEC-04 S5)
     Shibboleth SP 3.x configuration for the development environment: plain HTTP on 127.0.0.1 (ADR-02; the
     acceptance guard allows only http://127.0.0.1), one trusted IdP (the bundled test_idp), and a RequestMap
     rule that denies users without the `member` affiliation (the S5 rejection case). -->
<SPConfig xmlns="urn:mace:shibboleth:3.0:native:sp:config"
          xmlns:conf="urn:mace:shibboleth:3.0:native:sp:config"
          clockSkew="180">

  <OutOfProcess tranLogFormat="%u|%s|%IDP|%i|%ac|%t|%attr|%n|%b|%E|%S|%SS|%L|%UA|%a" />

  <RequestMapper type="Native">
    <RequestMap applicationId="default">
      <!-- The whole site is protected; the GRDM institution login lands here. -->
      <Host name="127.0.0.1" port="${GRDM_PORT_SHIBBOLETH_SP}" scheme="http" authType="shibboleth" requireSession="true">
        <!-- S5 rejection: a session whose eduPersonAffiliation lacks `${SP_REQUIRED_AFFILIATION}` is refused with 403. -->
        <AccessControl>
          <Rule require="affiliation">${SP_REQUIRED_AFFILIATION}</Rule>
        </AccessControl>
        <!-- Health probe and the SP's own metadata need no session. -->
        <Path name="Shibboleth.sso" authType="None" requireSession="false" />
        <Path name="healthz" authType="None" requireSession="false" />
      </Host>
    </RequestMap>
  </RequestMapper>

  <ApplicationDefaults entityID="http://127.0.0.1:${GRDM_PORT_SHIBBOLETH_SP}/shibboleth"
                       REMOTE_USER="eppn persistent-id targeted-id"
                       cipherSuites="DEFAULT:!EXP:!LOW:!aNULL:!eNULL:!DES:!IDEA:!SEED:!RC4:!3DES:!kRSA:!SSLv2:!SSLv3:!TLSv1:!TLSv1.1">

    <!-- Session cookie: HttpOnly + SameSite=Lax, no Secure flag because the loopback transport is plain HTTP.
         handlerSSL="false" lets /Shibboleth.sso/* answer on http. redirectLimit keeps the SP from sending the
         browser off the machine (SPEC-04 §3.4). -->
    <Sessions lifetime="28800" timeout="3600" relayState="ss:mem"
              checkAddress="false" handlerSSL="false"
              cookieProps="${SP_COOKIE_PROPS}"
              redirectLimit="host" redirectAllow="http://127.0.0.1:${GRDM_PORT_WEB}/ http://127.0.0.1:${GRDM_PORT_SHIBBOLETH_SP}/">
      <SSO entityID="http://127.0.0.1:${GRDM_PORT_TEST_IDP}/simplesaml/saml2/idp/metadata.php">SAML2</SSO>
      <Logout>SAML2 Local</Logout>
      <LogoutInitiator type="Admin" Location="/Logout/Admin" acl="127.0.0.1 ::1" />
      <Handler type="MetadataGenerator" Location="/Metadata" signing="false" />
      <Handler type="Status" Location="/Status" acl="127.0.0.1 ::1" />
      <Handler type="Session" Location="/Session" showAttributeValues="false" />
      <Handler type="DiscoveryFeed" Location="/DiscoFeed" />
    </Sessions>

    <!-- The error pages the S5 rejection case asserts on (visible text, SPEC-04 §3.1). -->
    <Errors supportContact="mock-sp-admin@idp.mock.test" helpLocation="/about.html" styleSheet="/shibboleth-sp/main.css" />

    <!-- Only the bundled test IdP is trusted; its metadata is rendered from sp-idp-metadata.xml.tmpl. -->
    <MetadataProvider type="XML" validate="true" path="${IDP_METADATA_FILE}" />

    <AttributeExtractor type="XML" validate="true" reloadChanges="false" path="attribute-map.xml" />
    <AttributeFilter type="XML" validate="true" path="attribute-policy.xml" />
    <AttributeResolver type="Query" subjectMatch="true" />

    <!-- Self-signed pair written by `secrets init` (follow-up F-2) and mounted read-only. -->
    <CredentialResolver type="File" use="signing" key="sp-key.pem" certificate="sp-cert.pem" />
    <CredentialResolver type="File" use="encryption" key="sp-key.pem" certificate="sp-cert.pem" />
  </ApplicationDefaults>

  <SecurityPolicyProvider type="XML" validate="true" path="security-policy.xml" />
  <ProtocolProvider type="XML" validate="true" reloadChanges="false" path="protocols.xml" />
</SPConfig>
