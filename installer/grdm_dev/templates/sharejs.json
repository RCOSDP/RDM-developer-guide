{
  "service": "sharejs",
  "component": "sharejs",
  "expose": [
    7007
  ],
  "env_files": [
    "sharejs.env"
  ],
  "environment": {
    "SHAREJS_COOKIE_SECRET": "${SHAREJS_SECRET}"
  },
  "tmpfs": [
    "/tmp"
  ],
  "user": "1000:1000",
  "depends_on": [
    "mongo",
    "web"
  ],
  "weight": 1,
  "mem_min_mb": 128,
  "pids_limit": 256
}
