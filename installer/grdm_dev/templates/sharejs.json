{
  "service": "sharejs",
  "component": "sharejs",
  "env_files": [
    "sharejs.env"
  ],
  "environment": {
    "SHAREJS_COOKIE_SECRET": "${SHAREJS_SECRET}",
    "MONGO_TLS_CA_FILE": "/mongo-tls/mongodb.crt"
  },
  "tmpfs": [
    "/tmp"
  ],
  "user": "1000:1000",
  "depends_on": [
    "mongo",
    "web"
  ],
  "weight": 1,
  "mem_min_mb": 128,
  "pids_limit": 256,
  "volumes": [
    {
      "volume": "mongo_tls",
      "target": "/mongo-tls",
      "ro": true
    }
  ],
  "container_port": 7007,
  "host_port": 7007
}
