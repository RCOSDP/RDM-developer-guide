{
  "service": "unoconv",
  "component": "unoconv",
  "expose": [
    2002
  ],
  "command": [
    "/bin/bash",
    "-c",
    "/usr/bin/python3.7 /usr/local/bin/unoconv --listener --server=0.0.0.0 --port=2002 -vvv"
  ],
  "environment": {
    "UNO_PATH": "/usr/lib/libreoffice",
    "HOME": "/tmp"
  },
  "volumes": [
    {
      "volume": "wb_tmp",
      "target": "/tmp"
    }
  ],
  "weight": 2,
  "mem_min_mb": 512,
  "pids_limit": 512
}
