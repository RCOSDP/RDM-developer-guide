{
  "service": "wiki",
  "component": "wiki-frontend",
  "container_port": 3000,
  "expose": [
    3000
  ],
  "environment": {
    "NODE_ENV": "development",
    "HOST": "0.0.0.0",
    "PORT": "3000",
    "OSF_URL": "http://127.0.0.1:{{HOST_PORT:web}}",
    "Y_WEBSOCKET_URL": "ws://y_websocket:1234",
    "HOME": "/tmp"
  },
  "tmpfs": [
    "/tmp"
  ],
  "user": "1000:1000",
  "depends_on": [
    "web",
    "y_websocket"
  ],
  "weight": 1,
  "mem_min_mb": 256,
  "pids_limit": 512,
  "note": "Container port and variable names are provisional until the integration repository documents them."
}
