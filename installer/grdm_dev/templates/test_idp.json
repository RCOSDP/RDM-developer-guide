  "service": "test_idp",
  "component": "Shibboleth-SP",
  "container_port": 8443,
  "expose": [
    8443
  ],
  "tmpfs": [
    "/tmp",
    "/run",
    "/var/run"
  ],
  "weight": 1,
  "mem_min_mb": 256,
