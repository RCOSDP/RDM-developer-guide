.DS_Store

# grdm-dev runtime (generated, contains secrets); runtime.*/ are operator-made copies of it (a moved-aside
# runtime from a cold-start test got scanned by Semgrep in real install run 20 because only runtime/ was ignored)
runtime/
runtime.*/
.venv/
__pycache__/
*.pyc
.pytest_cache/

# Python packaging artifacts
installer/build/
installer/*.egg-info/
*.egg-info/
